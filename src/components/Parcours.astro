---
import { parcours } from '../data/parcours';
const NOMS: Record<string, string> = { OBS: 'Orange Business Services' };
---
  <section class="section" id="parcours" aria-labelledby="t-parcours">
    <div class="enveloppe">
      <div class="repere-section"><h2 id="t-parcours">parcours</h2><p class="legende">Un oiseau posé = deux mois passés.</p></div>
      <ol class="parcours">
        {parcours.map((p) => (
          <li data-annees={p.annees} class={p.missions && 'maison'}><span class="annees">{p.periode}</span><span class="poste">{p.poste}</span><span class="boite">{NOMS[p.boite] ? <abbr title={NOMS[p.boite]}>{p.boite}</abbr> : p.boite}</span>
            {p.missions && (
              <ol class="missions" aria-label={`Missions ${p.boite}`}>
                {p.missions.map((m) => (
                  <li data-annees={m.annees}><span class="annees">{m.periode}</span><span class="poste">{m.poste}</span><span class="boite"><span class="mission">mission</span> {m.boite}</span></li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
