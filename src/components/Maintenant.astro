---
// « maintenant » : les étapes sur lesquelles la nuée se pose.

// Téléchargements npm d’Angular Tiptap Editor, au build : ceux de la dernière semaine (last-week), à la centaine.
// Sans réponse, ou si les chiffres de npm ont plus de dix jours, on garde « environ 2 000 ».
let telechargements = 2000;
try {
  const r = await fetch('https://api.npmjs.org/downloads/point/last-week/@flogeez/angular-tiptap-editor', { signal: AbortSignal.timeout(5000) });
  const j = await r.json();
  if (r.ok && Date.now() - new Date(j.end).getTime() < 10 * 864e5) telechargements = Math.round(j.downloads / 100) * 100;
} catch {}
const parSemaine = telechargements.toLocaleString('fr-FR').replace(/\s/g, '\u00a0');

// La planche de l’étape etourneau, comme sur la page de la marque : l’oiseau posé sur sa branche (planche-geometrie.js)
import { PERCHED, wing, perchedLegs } from 'etourneau/starling';
import { brancheY, K, X0, Y0 } from '../scripts/planche-geometrie.js';
// la branche, seulement dans le cadre de la planche (x de 234 à 778)
const BRANCHE_VUE = 'M' + Array.from({ length: 35 }, (_, i) => { const x = 234 + i * 16; return `${x} ${brancheY(x).toFixed(1)}`; }).join(' L');
---
