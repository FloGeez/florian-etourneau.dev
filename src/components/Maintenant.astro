---
// « maintenant » : les étapes sur lesquelles la nuée se pose.

// Téléchargements npm d’Angular Tiptap Editor, au build : la moyenne par semaine du dernier mois, à la centaine.
// Sans réponse, ou si les chiffres de npm ont plus de dix jours, on garde « environ 2 000 ».
let telechargements = 2000;
try {
  const r = await fetch('https://api.npmjs.org/downloads/point/last-month/@flogeez/angular-tiptap-editor', { signal: AbortSignal.timeout(5000) });
  const j = await r.json();
  if (r.ok && Date.now() - new Date(j.end).getTime() < 10 * 864e5) telechargements = Math.round(j.downloads / 30 * 7 / 100) * 100;
} catch {}
const parSemaine = telechargements.toLocaleString('fr-FR').replace(/\s/g, '\u00a0');
