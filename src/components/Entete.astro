---
// En-tête : logo, liens, bascule de thème. `accueil` préfixe les ancres hors de la page d’accueil (404).
import { PERCHED, wing } from 'etourneau/starling';
const AILE_PLIEE = wing(0);
interface Props { accueil?: string }
const { accueil = '' } = Astro.props;
---
<header class="entete">
  <div class="enveloppe">
    <a class="marque" href={accueil + '#haut'} aria-label="Florian Etourneau, accueil"><svg class="logo" viewBox="40 24 140 176" aria-hidden="true"><clipPath id="lg"><path d={PERCHED.BODY}/></clipPath><path class="fe-corps" d={PERCHED.BODY}/><g clip-path="url(#lg)"><path class="fe-ventre" d={PERCHED.BELLY}/><path class="fe-aile" d={AILE_PLIEE}/></g><path class="fe-bec" d={PERCHED.BEAK}/><circle class="fe-oeil" {...PERCHED.EYE}/><circle class="fe-reflet" {...PERCHED.HIGHLIGHT}/></svg><span>Florian Etourneau</span></a>
    <nav class="nav" aria-label="Liens">
      <a class="ic-lien" href="https://github.com/FloGeez" aria-label="GitHub" target="_blank" rel="noopener noreferrer"><span class="ic-marque ic-github" aria-hidden="true"></span><span>GitHub</span></a>
      <a class="ic-lien" href="https://www.linkedin.com/in/florian-etourneau-24066b56/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><span class="ic-marque ic-linkedin" aria-hidden="true"></span><span>LinkedIn</span></a>
      <a class="contact-lien" href={accueil + '#contact'}>contact</a>
      <button class="theme" id="bouton-theme" type="button" aria-label="Changer de thème"><svg class="picto soleil" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="flex-shrink: 0;"><path d="M12 12 m-4 0 a4 4 0 1 0 8 0 a4 4 0 1 0 -8 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M5.3 18.7 L6.7 17.3 M17.3 6.7 L18.7 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><svg class="picto lune" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="flex-shrink: 0;"><path d="M20 14.5 C18.9 18.3 15.3 21 11.2 20.7 C6.5 20.3 3 16.3 3.3 11.6 C3.6 7.6 6.4 4.4 10.2 3.6 C8.4 6.4 8.6 10.1 10.9 12.6 C13.3 15.2 17 15.9 20 14.5 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
    </nav>
  </div>
</header>
