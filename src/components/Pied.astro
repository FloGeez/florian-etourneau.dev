---
// Contact, heure et météo au nord de Rennes, la famille sur le fil.
const annee = new Date().getFullYear();
---
<footer class="pied" id="contact">
  <div class="enveloppe haut">
    <div class="repere-section"><h2 id="t-contact">contact</h2></div><p class="contact-appel">Un besoin complexe, une équipe à outiller ? Écris-moi.</p>
    <div class="contact-pied"><strong id="adresse">florian.etourneau<wbr />@gmail.com</strong><button class="copier" id="copier" type="button"><svg class="picto enveloppe-ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="flex-shrink: 0;"><path d="M5 5 H19 C20.1 5 21 5.9 21 7 V17 C21 18.1 20.1 19 19 19 H5 C3.9 19 3 18.1 3 17 V7 C3 5.9 3.9 5 5 5 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3.5 7 L12 13 L20.5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><svg class="coche" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="coche-trace" pathLength="1" d="M4 11 L9.5 16.5 L20 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle class="coche-ballon fe-ballon" r="3.4"/></svg><span>Copier</span></button><button class="copier ecrire" id="ecrire" type="button" aria-expanded="false" aria-controls="formulaire" hidden>Écrire un message</button><span class="statut-copie" id="statut-copie" role="status" aria-live="polite"></span></div>
    <div class="contact-zone" id="contact-zone">
    <form class="formulaire" id="formulaire" method="post" novalidate hidden>
      <div class="champ"><label for="f-nom">Nom</label><input id="f-nom" name="nom" type="text" autocomplete="name" maxlength="100" required aria-describedby="a-nom" /><span class="aide" id="a-nom"></span></div>
      <div class="champ"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" maxlength="200" required aria-describedby="a-email" /><span class="aide" id="a-email"></span></div>
      <div class="champ large"><label for="f-message">Message</label><textarea id="f-message" name="message" rows="4" minlength="10" maxlength="5000" required aria-describedby="a-message"></textarea><span class="aide" id="a-message"></span></div>
      <label class="pot-de-miel" aria-hidden="true">Ne pas remplir <input name="site" type="text" tabindex="-1" autocomplete="off" /></label>
      <div class="formulaire-bas large"><p class="statut-envoi" id="statut-envoi" role="status" aria-live="polite"></p><button class="copier envoyer" id="envoyer" type="submit"><span>Envoyer</span></button></div>
    </form>
    <div class="envoi" id="envoi" hidden><p class="envoi-texte" id="envoi-texte" role="status" tabindex="-1">Message envoyé. <span>Merci, je te réponds vite.</span></p></div>
    </div>
  </div>
  <div class="enveloppe"><p class="chez-moi"><svg class="picto" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 22 C12 22 19.5 15.4 19.5 9.8 C19.5 5.8 16.2 2.5 12 2.5 C7.8 2.5 4.5 5.8 4.5 9.8 C4.5 15.4 12 22 12 22 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9.8 m-2.5 0 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0" fill="none" stroke="currentColor" stroke-width="2"/></svg><span><strong id="heure">—</strong><span id="meteo" hidden> · <strong id="temperature"></strong></span> au nord de Rennes, où je vis avec ma femme et nos trois enfants.</span></p></div><div class="scene-pied"><svg class="famille" viewBox="0 0 1200 240" role="img" aria-label="La famille Etourneau sur le fil : Florian, sa femme et leurs trois enfants"><path class="fe-fil" d="M0 196 Q600.0 212 1200 196"/><g id="nid" class="attend"><svg x="576.5" y="77.0" width="104" height="130.7" viewBox="40 24 140 176"><path class="fe-pattes" d="M98 150 L96 192 M91 194 L96 192 L101 195 M110 146 L111 192 M106 194 L111 192 L116 195"/><clipPath id="fb0"><path d="M140 48 C132 34 108 32 98 46 C88 60 86 80 84 100 C82 130 70 160 52 192 L68 194 C80 176 92 164 102 156 C130 146 150 120 146 88 C145 78 143 70 140 66 Z"/></clipPath><path class="fe-corps" d="M140 48 C132 34 108 32 98 46 C88 60 86 80 84 100 C82 130 70 160 52 192 L68 194 C80 176 92 164 102 156 C130 146 150 120 146 88 C145 78 143 70 140 66 Z"/><g clip-path="url(#fb0)"><path class="fe-ventre" d="M98 176 C100 136 120 108 164 98 L200 98 L200 200 L98 200 Z"/><path class="fe-aile" d="M94 62 C118 80 122 116 106 150 L56 198 C74 150 80 104 94 62 Z"/></g><path class="fe-bec" d="M138 49 L172 59 L139 65 Z"/><circle class="fe-oeil" cx="125" cy="54" r="4.6"/><circle class="fe-reflet" cx="126.6" cy="52.6" r="1.4"/></svg></g><path class="fe-place" d="M608.0 201.0 H640.0"/><svg x="693.0" y="88.7" width="94" height="118.2" viewBox="40 24 140 176"><g transform="translate(220,0) scale(-1,1)"><path d="M98 150 L96 192 M