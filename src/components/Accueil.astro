---
// Accroche + scène du tir (le fil, l’oiseau, le panier, le tableau d’affichage).
import { PERCHED, FLYING, wing, flightWings } from 'etourneau/starling';
const AILE_LEVEE = wing(1), VOL = flightWings(0, 1, 0);
---
  <section class="accueil" id="haut">
    <div class="enveloppe">
      <p class="surtitre">Lead Product Engineer chez MaxDS&nbsp;·&nbsp;Rennes</p>
      <h1>Je fais simple. <span class="deux">À utiliser, à faire évoluer.</span></h1>
      <p class="intro">Développeur et lead technique avec plus de dix ans d’expérience, je conçois des applications de bout en bout avec deux priorités&nbsp;: livrer des interfaces évidentes pour l’utilisateur et simplifier la vie des développeurs qui les construisent avec moi.</p>
    </div>
    <div class="scene-accueil"><svg class="scene" viewBox="0 40 1200 330" role="group" aria-label="L’étourneau sur son fil, ballon levé, face au panier. Tire toi-même&nbsp;: glisse le ballon vers l’arrière pour viser et doser, puis lâche, ou appuie sur Entrée. Le tableau d’affichage compte les paniers, les tirs et les 24 secondes."><path class="fe-fil" d="M0 340 Q600.0 360 1200 340"/><path id="trajectoire" class="fe-trajectoire" d=""/><g id="visee" hidden><path id="visee-dir" class="fe-visee"/><path id="visee-force" class="fe-force"/></g><g class="ballon" id="ballon" transform="translate(740.5 137)" tabindex="0" role="button" aria-label="Tirer au panier"><circle class="zone-ballon" r="44" fill="transparent"></circle><circle class="peau-ballon fe-ballon" r="16"></circle><g class="fe-couture" stroke-width="2.0"><path d="M-16 0 L16 0 M0 -16 L0 16"></path><path d="M-11.2 -11.2 C-3.7 -3.8 -3.7 3.7 -11.2 11.2 M11.2 -11.2 C3.8 -3.8 3.8 3.7 11.2 11.2"></path></g></g><g id="filet" fill="none" class="fe-filet" stroke-width="1.9" stroke-linecap="round"><path d="M988.2 159.5 L1004.1 207.0"></path><path d="M1009.1 159.5 L1017.0 207.0"></path><path d="M1030.0 159.5 L1030.0 207.0"></path><path d="M1050.9 159.5 L1043.0 207.0"></path><path d="M1071.8 159.5 L1055.9 207.0"></path><path d="M994.6 178.5 Q1030.0 182.3 1065.4 178.5"></path><path d="M1000.1 195.1 Q1030.0 198.9 1059.9 195.1"></path></g><path d="M1089.4 178.5 L1089.4 343.3" class="fe-encre-s" stroke-width="3.8" stroke-linecap="round"></path><rect x="1085.1" y="77.8" width="8.5" height="106.4" rx="1.9" class="fe-encre-f"></rect><path d="M1085.1 153.8 L1071.8 159.5" class="fe-encre-s" stroke-width="4.8" stroke-linecap="round"></path><ellipse cx="1030.0" cy="159.5" rx="41.8" ry="6.6" fill="none" class="fe-cercle" stroke-width="5.7"></ellipse><g id="tireur"><svg id="oiseau-pose" x="660.6" y="190.8" width="130" height="163.4" viewBox="40 24 140 176"><path id="pattes-pose" class="fe-pattes" d="M98 150 L96 192 M91 194 L96 192 L101 195 M110 146 L111 192 M106 194 L111 192 L116 195"/><clipPath id="hp"><path d={PERCHED.BODY}/></clipPath><g id="corps-pose"><path class="fe-corps" d={PERCHED.BODY}/><ellipse id="crane-pose" class="fe-corps" {...PERCHED.SKULL}/><g clip-path="url(#hp)"><path class="fe-ventre" d={PERCHED.BELLY}/><path id="aile-pliee" class="fe-aile" d={AILE_LEVEE}/></g><g id="tete-pose"><path class="fe-bec" d={PERCHED.BEAK}/><path id="bec-face" class="fe-bec" d={PERCHED.BEAK_FRONT} opacity="0"/><circle class="fe-oeil" {...PERCHED.EYE}/><circle class="fe-reflet" {...PERCHED.HIGHLIGHT}/></g><path id="aile-dessus" class="fe-aile" d={AILE_LEVEE}/></g></svg></g><g id="oiseau-vol" hidden><g class="flight-inner"><path class="fe-aile-loin wing-far" d={VOL.far}></path><defs><clipPath id="fu"><path d={FLYING.BODY}></path></clipPath></defs><path d={FLYING.BODY} class="fe-corps"></path><g clip-path="url(#fu)"><path d={FLYING.BELLY} class="fe-ventre"></path></g><path class="fe-aile wing-near" d={VOL.near}></path><path d={FLYING.BEAK} class="fe-bec"></path><circle {...FLYING.EYE} class="fe-oeil"></circle><circle {...FLYING.HIGHLIGHT} class="fe-ventre"></circle></g></g></svg><div class="tableau range" id="tableau" aria-hidden="true" data-bulle="«&nbsp;We’re talking about practice, man. Not a game… we’re talking about practice.&nbsp;» — Allen Iverson"><span class="tableau-marque">BODET</span><span class="tableau-cases"><span class="tableau-case"><b id="t-paniers">00</b><i>paniers</i></span><span class="tableau-case tableau-case-24"><b id="t-24">24</b><i>poss.</i></span><span class="tableau-case"><b id="t-tirs">00</b><i>tirs</i></span></span></div><span class="tableau-potence range" aria-hidden="true"></span><p class="indice-tir" id="indice-tir" aria-hidden="true"><svg viewBox="0 0 8 10" aria-hidden="true"><path d="M8 0 L0 5 L8 10 Z"/></svg><span>à toi de tirer</span></p><p class="contre" id="contre" aria-hidden="true">BLOCKED BY ÉTOURNEAU&nbsp;!</p></div>
  </section>
