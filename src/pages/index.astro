---
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Accueil from '../components/Accueil.astro';
import Maintenant from '../components/Maintenant.astro';
import Parcours from '../components/Parcours.astro';
import Pied from '../components/Pied.astro';
---
<Base>
  <canvas class="nuee-page" id="nuee" aria-hidden="true"></canvas>
  <Entete />
  <main id="contenu">
    <Accueil />
    <Maintenant />
    <Parcours />
  </main>
  <Pied />
  <script>
    import '../scripts/site.js';
  </script>
</Base>
